# Copy this file to .env (gitignored) and fill in real values. Used by
# docker-compose.yml / docker-compose.dist.yml / docker-compose.offline.yml.
#
# The api service (`autosys scheduler serve`) refuses to start unless
# AUTOSYS_JWT_SECRET and AUTOSYS_USERS are both set -- see
# autosys/app_server/auth.py's module docstring for why: auth used to
# default off with a baked-in admin/admin/operator/viewer set of accounts,
# which meant anyone who could reach the server was an anonymous admin.

# A random secret, NOT the placeholder below (that exact string is rejected
# on purpose). Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
AUTOSYS_JWT_SECRET=dev-secret-change-in-production

# Leave "true" unless you have a specific reason to run auth off (which
# only works against a locally-built image -- `serve` still refuses to
# start it as a real network-facing entrypoint).
AUTOSYS_AUTH_ENABLED=true

# JSON mapping of username -> {password, role}. role is one of:
#   viewer   -- read-only (GET endpoints only)
#   operator -- can also enqueue events (STARTJOB, KILLJOB, ...)
#   admin    -- full access including DELETE and machine management
# This is also what Shinro's tool-execution service logs into this server
# with (SIMULATOR_AUTH_USERNAME/PASSWORD in shinro's own docker-compose.yml
# env_file) when the two are run side by side on a shared network -- keep
# one entry's username/password in sync with those two settings there.
AUTOSYS_USERS={"admin":{"password":"change-me","role":"admin"}}
