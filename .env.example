# Copy this file to .env (gitignored) and fill in real values. Used by
# docker-compose.yml / docker-compose.dist.yml.
#
# The api service (`autosys scheduler serve`) refuses to start unless
# AUTOSYS_JWT_SECRET and every AUTOSYS_OIDC_*/AUTOSYS_PUBLIC_URL setting
# below are set -- see autosys/app_server/auth.py's module docstring for
# why: this server verifies sign-ins against Cognito, so it has nothing to
# check anyone against without them.

# A random secret, NOT the placeholder below (that exact string is rejected
# on purpose). Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Signs only this app's own session and OIDC-state cookies -- never shared
# with another service.
AUTOSYS_JWT_SECRET=dev-secret-change-in-production

# Leave "true" unless you have a specific reason to run auth off (which
# only works against a locally-built image -- `serve` still refuses to
# start it as a real network-facing entrypoint).
AUTOSYS_AUTH_ENABLED=true

# --- Cognito sign-in ---
# The SAME pool Shinro's own users sign in through (its COGNITO_REGION/
# COGNITO_USER_POOL_ID/COGNITO_DOMAIN, in shinro's own apps/api/.env) --
# that is what makes this single sign-on: log in to either app and the
# other opens without a prompt.
AUTOSYS_OIDC_REGION=us-east-1
AUTOSYS_OIDC_USER_POOL_ID=us-east-1_XXXXXXXXX
AUTOSYS_OIDC_DOMAIN=https://your-domain.auth.us-east-1.amazoncognito.com
# This console's OWN app client in that pool -- a public client (no secret),
# separate from Shinro's own COGNITO_CLIENT_ID. Callback URL registered on
# it: ${AUTOSYS_PUBLIC_URL}/api/v1/auth/callback.
AUTOSYS_OIDC_CLIENT_ID=your_wcc_app_client_id
# This console's own externally-reachable origin -- used to build the
# Cognito redirect/logout URLs and to reject cross-origin requests.
AUTOSYS_PUBLIC_URL=http://localhost:8080

# --- Machine-to-machine (Shinro's worker) ---
# Comma-separated client_id(s) trusted for the client-credentials grant --
# Shinro's worker is issued a short-lived, read-only token by Cognito
# itself (see shinro's SIMULATOR_OAUTH_CLIENT_ID/SECRET), never a password
# checked against anything here.
AUTOSYS_M2M_CLIENT_IDS=your_shinro_worker_app_client_id
AUTOSYS_M2M_SCOPE=autosys-simulator/read

# --- Roles ---
# Cognito groups this pool's users can be in, separate from Shinro's own
# Admin/Developer/Viewer groups -- simulator access is granted on purpose,
# per group, never implied by Shinro access:
#   simulator-viewer   -- read-only (GET endpoints only)
#   simulator-operator -- can also enqueue events (STARTJOB, KILLJOB, ...)
#     and import JIL/run history
#   simulator-admin     -- full access including DELETE and machine management
# A user in none of these groups gets a 403 on sign-in.

# --- Postgres (docker-compose.yml / .dist.yml / .offline.yml only --
# irrelevant if you're running the bare CLI against SQLite, which is the
# default there). All three default to "autosys" if left unset; only
# override if you need different credentials. ---
AUTOSYS_DB_USER=autosys
AUTOSYS_DB_PASSWORD=autosys
AUTOSYS_DB_NAME=autosys
