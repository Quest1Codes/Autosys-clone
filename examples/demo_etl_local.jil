/* ================================================================
   demo_etl_local.jil — ETL pipeline configured for LOCAL execution
   All scripts point to ./scripts/ and run on localhost
   ================================================================ */

/* --- The parent BOX job ---------------------------------------- */
insert_job: demo_etl_box   job_type: BOX
owner: svc_demo
start_times: "06:00"
days_of_week: mo,tu,we,th,fr
max_run_alarm: 120
alarm_if_fail: 1

/* --- Step 1: Check source data file exists -------------------- */
insert_job: check_source_ready   job_type: CMD
owner: svc_demo
box_name: demo_etl_box
command: "/Users/micheal/quest1works/AutosysToAstronomer/Autosys-clone/scripts/check_file.sh /Users/micheal/quest1works/AutosysToAstronomer/Autosys-clone/data/inbound/sales_sample.csv"
machine: localhost
std_out_file: /Users/micheal/quest1works/AutosysToAstronomer/Autosys-clone/logs/demo/check_source.out
std_err_file: /Users/micheal/quest1works/AutosysToAstronomer/Autosys-clone/logs/demo/check_source.err
n_retrys: 2
alarm_if_fail: 1

/* --- Step 2: Extract and clean data --------------------------- */
insert_job: extract_sales   job_type: CMD
owner: svc_demo
box_name: demo_etl_box
command: "/Users/micheal/quest1works/AutosysToAstronomer/Autosys-clone/scripts/extract_sales.sh --date %%DATE%%"
machine: localhost
std_out_file: /Users/micheal/quest1works/AutosysToAstronomer/Autosys-clone/logs/demo/extract_sales.out
std_err_file: /Users/micheal/quest1works/AutosysToAstronomer/Autosys-clone/logs/demo/extract_sales.err
condition: success(check_source_ready)
alarm_if_fail: 1

/* --- Step 3a: Generate the sales report (parallel) ------------ */
insert_job: generate_report   job_type: CMD
owner: svc_demo
box_name: demo_etl_box
command: "python3 /Users/micheal/quest1works/AutosysToAstronomer/Autosys-clone/scripts/gen_report.py --type sales --date %%DATE%%"
machine: localhost
std_out_file: /Users/micheal/quest1works/AutosysToAstronomer/Autosys-clone/logs/demo/gen_report.out
std_err_file: /Users/micheal/quest1works/AutosysToAstronomer/Autosys-clone/logs/demo/gen_report.err
condition: success(extract_sales)
alarm_if_fail: 1

/* --- Step 3b: Load into warehouse (parallel with 3a) ---------- */
insert_job: load_to_warehouse   job_type: CMD
owner: svc_demo
box_name: demo_etl_box
command: "/Users/micheal/quest1works/AutosysToAstronomer/Autosys-clone/scripts/load_snowflake.sh --date %%DATE%%"
machine: localhost
std_out_file: /Users/micheal/quest1works/AutosysToAstronomer/Autosys-clone/logs/demo/load_warehouse.out
std_err_file: /Users/micheal/quest1works/AutosysToAstronomer/Autosys-clone/logs/demo/load_warehouse.err
condition: success(extract_sales)
alarm_if_fail: 1

/* --- Step 4: Send success notification ------------------------ */
insert_job: send_success_email   job_type: CMD
owner: svc_demo
box_name: demo_etl_box
command: "/Users/micheal/quest1works/AutosysToAstronomer/Autosys-clone/scripts/send_email.sh 'Sales ETL complete for %%DATE%%'"
machine: localhost
std_out_file: /Users/micheal/quest1works/AutosysToAstronomer/Autosys-clone/logs/demo/send_email.out
std_err_file: /Users/micheal/quest1works/AutosysToAstronomer/Autosys-clone/logs/demo/send_email.err
condition: success(generate_report) & success(load_to_warehouse)
alarm_if_fail: 1

/* --- Standalone: Nightly cleanup ------------------------------ */
insert_job: nightly_cleanup   job_type: CMD
owner: svc_demo
command: "/Users/micheal/quest1works/AutosysToAstronomer/Autosys-clone/scripts/cleanup_temp.sh --days 7"
machine: localhost
start_times: "23:00"
days_of_week: all
